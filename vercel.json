{
  "version": 2,
  "builds": [
    {
      "src": "backend/app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/showroom(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/cars(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/conversation(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/leads(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/negotiation(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/escalation(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/vehicles(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/agora(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/scoring(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/demo(.*)",
      "dest": "backend/app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
